     "settings": {
      "html": "<section class=\"trust\" aria-labelledby=\"h-trust\">\n    <div class=\"wrap\">\n      <h2 id=\"h-trust\">How this guide works</h2>\n      <ul class=\"trust-list\">\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#ph-book-open\"/></svg><p><b>Sourced.</b> Health and safety statements in our guides are checked against named sources, such as veterinary and animal-welfare organizations, and the sources are listed on each guide.</p></li>\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#ph-stethoscope\"/></svg><p><b>Your vet comes first.</b> We help you recognize when something may be wrong and send you to your vet. We don’t diagnose or recommend treatments.</p></li>\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#ph-pencil-simple-line\"/></svg><p><b>Corrections welcome.</b> Spotted a mistake? <a href=\"/contact/\">Send a correction</a>.</p></li>\n      </ul>\n      <p class=\"trust-links\"><a href=\"/editorial-policy/\">How our guides are written and funded</a><a href=\"/dog-grooming-glossary/\">New to grooming words? See the grooming glossary</a></p>\n    </div>\n  </section>"
     },
