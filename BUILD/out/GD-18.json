[{"id": "2dcbcc0", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "f263420", "elType": "widget", "widgetType": "shortcode", "settings": {"shortcode": "[rank_math_breadcrumb]"}, "elements": []}, {"id": "8a93952", "elType": "widget", "widgetType": "heading", "settings": {"title": "About Grooming Dogs", "header_size": "h1"}, "elements": []}, {"id": "b953527", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grooming Dogs is a guide to looking after your dog's coat, skin, nails, ears and teeth at home. It also helps you decide when to hand a job over to a professional groomer or your vet. This page explains what the site is, who's behind it, how it's paid for, and how to tell us if we've got something wrong.</p>"}, "elements": []}], "isInner": false}, {"id": "5ea1db0", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "5f103c7", "elType": "widget", "widgetType": "heading", "settings": {"title": "What Grooming Dogs is", "header_size": "h2", "_element_id": "what-grooming-dogs-is"}, "elements": []}, {"id": "7071c15", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li><strong>Practical guides for dog owners:</strong> an editorial site covering bathing, brushing, haircuts and trimming, nails, ears and teeth, plus how often to do each job, which tools you need, and how to adapt grooming for puppies, older dogs and nervous dogs.</li><li><strong>One task per guide:</strong> each guide covers one job and starts with a short answer. Where another guide already covers something, we link to it instead of repeating it.</li><li><strong>Named sources:</strong> health and safety statements are backed by named sources, such as veterinary organizations and animal-welfare groups, and cited on the page.</li><li><strong>Dated prices:</strong> prices come from published price lists, with the date we checked them.</li></ul>"}, "elements": []}], "isInner": false}, {"id": "e65d478", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "71b6e46", "elType": "widget", "widgetType": "heading", "settings": {"title": "What this site is not", "header_size": "h2", "_element_id": "what-this-site-is-not"}, "elements": []}, {"id": "092e607", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li><strong>Not a grooming salon or grooming business.</strong> We don't groom dogs, take bookings, or list or recommend individual groomers. If you're looking for one, our guide to <a href=\"/choosing-a-dog-groomer/\">choosing a groomer</a> explains what to look for.</li><li><strong>Not veterinary advice.</strong> Our guides are general information. They point you to your vet whenever a sign could mean pain, injury or illness, and they don't diagnose or recommend treatments.</li><li><strong>Not vet-reviewed unless a page says so.</strong> If a qualified expert reviews a guide, that page will show their name, their credential and the date they reviewed it.</li></ul>"}, "elements": []}], "isInner": false}, {"id": "eef7482", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "41a7412", "elType": "widget", "widgetType": "heading", "settings": {"title": "Who runs the site", "header_size": "h2", "_element_id": "who-runs-the-site"}, "elements": []}, {"id": "f5c2a89", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grooming Dogs publishes its guides under the name <strong>Grooming Dogs</strong>, so the guides carry the byline \"Grooming Dogs\" rather than an individual's name. If a guide is written, edited or reviewed by a named person, the page will say so, with their real name and role.</p>"}, "elements": []}], "isInner": false}, {"id": "619fdf4", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "59afd0e", "elType": "widget", "widgetType": "heading", "settings": {"title": "How the site is funded", "header_size": "h2", "_element_id": "how-the-site-is-funded"}, "elements": []}, {"id": "e2e3804", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grooming Dogs is editorial first. Our guides are planned around what dog owners need to know, not around what earns money. To pay for the site:</p>\n<ul><li><strong>Affiliate links:</strong> some pages may include affiliate links. A page with affiliate links says so before the first one.</li><li><strong>Ads:</strong> some pages may show clearly labelled advertisements.</li></ul>"}, "elements": []}, {"id": "8becccd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Commercial content doesn't decide which topics we cover or what our guides recommend. The details are in our <a href=\"/editorial-policy/\">editorial, sourcing and disclosure policy</a>.</p>"}, "elements": []}], "isInner": false}, {"id": "41c5712", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "696f2d1", "elType": "widget", "widgetType": "heading", "settings": {"title": "How the guides are organized", "header_size": "h2", "_element_id": "how-the-guides-are-organized"}, "elements": []}, {"id": "4a855b2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>The guides are grouped the way you'd look for them:</p>\n<ul><li><strong>Start here:</strong> the <a href=\"/how-to-groom-your-dog-at-home/\">full grooming routine</a>, how often to groom, and coat types.</li><li><strong>Grooming tasks:</strong> one guide each for bathing, brushing, haircuts and trimming, nails, ears and teeth.</li><li><strong>Your dog:</strong> puppies, senior dogs and anxious dogs.</li><li><strong>Problems:</strong> what to do if something looks wrong after grooming.</li><li><strong>Tools and groomers:</strong> choosing tools, choosing a groomer, and what grooming costs.</li></ul>"}, "elements": []}, {"id": "320abdc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>A glossary explains grooming terms, and the guides link to it.</p>"}, "elements": []}], "isInner": false}, {"id": "32fe64f", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 24, "column": "24", "row": "24", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}, "background_background": "classic", "background_color": "#F5F7F8", "__globals__": {"background_color": "globals/colors?id=gdsurfs"}}, "elements": [{"id": "f7a1121", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"how-this-guide-works\"><strong>How this guide works</strong></p>"}, "elements": []}, {"id": "b5ec2ec", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li><strong>Sourced.</strong> Health and safety statements in our guides are checked against named sources, such as veterinary and animal-welfare organizations, and the sources are listed on each guide.</li><li><strong>Your vet comes first.</strong> We help you recognize when something may be wrong and send you to your vet. We don't diagnose or recommend treatments.</li><li><strong>Corrections welcome.</strong> Spotted a mistake? <a href=\"/contact/\">Send a correction</a>.</li></ul><p><a href=\"/editorial-policy/\">How our guides are written and funded</a></p>"}, "elements": []}], "isInner": false}, {"id": "3afd992", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "50a95fd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Corrections and feedback", "header_size": "h2", "_element_id": "corrections-and-feedback"}, "elements": []}, {"id": "d28c905", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>If you spot a mistake, an out-of-date source or a broken link, please <a href=\"/contact/\">send a correction</a>. How we handle corrections is described in our <a href=\"/editorial-policy/\">editorial, sourcing and disclosure policy</a>.</p>"}, "elements": []}], "isInner": false}, {"id": "1adb61c", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}, "background_background": "classic", "background_color": "#F5F7F8", "__globals__": {"background_color": "globals/colors?id=gdsurfs"}}, "elements": [{"id": "cea53d6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"next\"><strong>Where to go next</strong></p>"}, "elements": []}, {"id": "b953356", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_wrap": "wrap", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "col