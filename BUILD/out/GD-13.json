nit": "%", "size": 100}}, "elements": [{"id": "8ed1a07", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/bathing-your-dog/\">Bathing your dog</a></strong></p><p>The full bathing method.</p>"}, "elements": []}], "isInner": true}, {"id": "2506cde", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "84b08ce", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/grooming-an-anxious-dog/\">Grooming a dog who hates being groomed</a></strong></p><p>If your older dog has become fearful.</p>"}, "elements": []}], "isInner": true}, {"id": "506b9a0", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "135c46a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/choosing-a-dog-groomer/\">Choosing a dog groomer</a></strong></p><p>Finding a gentle groomer.</p>"}, "elements": []}], "isInner": true}], "isInner": true}, {"id": "58903cd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>This is general information about grooming, not veterinary advice. If your dog seems sore, has a new lump, or has changed how they react to being handled, contact your vet. <a href=\"/editorial-policy/\">How we write, source and fund our guides</a>.</p>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}, {"id": "6e446ce", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"sources\"><strong>Sources</strong></p>\n<ul class=\"gd-sources\"><li id=\"s1\"><span class=\"gd-src-label\">[1]</span> Dhaliwal R, et al.: \"2023 AAHA Senior Care Guidelines for Dogs and Cats\", <em>Journal of the American Animal Hospital Association</em> (2023). <a href=\"https://www.aaha.org/wp-content/uploads/globalassets/02-guidelines/2023-aaha-senior-care-guidelines-for-dogs-and-cats/resources/2023-aaha-senior-care-guidelines-for-dogs-and-cats.pdf\">https://www.aaha.org/wp-content/uploads/globalassets/02-guidelines/2023-aaha-senior-care-guidelines-for-dogs-and-cats/resources/2023-aaha-senior-care-guidelines-for-dogs-and-cats.pdf</a></li><li id=\"s2\"><span class=\"gd-src-label\">[2]</span> Terry Albert, Fear Free Happy Homes: \"12 Tips To Caring For Your Senior Dog's Coat\" (reviewed by board-certified veterinary behaviorist Dr. Kenneth Martin and/or veterinary technician specialist Debbie Martin, LVT), February 6, 2018. <a href=\"https://www.fearfreehappyhomes.com/12-tips-to-caring-for-your-senior-dogs-coat/\">https://www.fearfreehappyhomes.com/12-tips-to-caring-for-your-senior-dogs-coat/</a></li><li id=\"s3\"><span class=\"gd-src-label\">[3]</span> American Veterinary Society of Animal Behavior (AVSAB) blog: \"Sudden change in your dog's behavior? He could be in pain\", updated December 11, 2024. <a href=\"https://avsab.org/sudden-change-in-your-dogs-behavior-he-could-be-in-pain/\">https://avsab.org/sudden-change-in-your-dogs-behavior-he-could-be-in-pain/</a></li><li id=\"s4\"><span class=\"gd-src-label\">[4]</span> Harriet Meyers, American Kennel Club: \"How to Trim Your Dog's Nails Safely\", updated June 1, 2026. <a href=\"https://www.akc.org/expert-advice/health/how-to-trim-dogs-nails-safely/\">https://www.akc.org/expert-advice/health/how-to-trim-dogs-nails-safely/</a></li><li id=\"s5\"><span class=\"gd-src-label\">[5]</span> Ann Hohenhaus, DVM, The Animal Medical Center: \"Can Bath Time be Dangerous for Pets?\", November 30, 2016. <a href=\"https://www.amcny.org/blog/2016/11/30/can-bath-time-dangerous-pets/\">https://www.amcny.org/blog/2016/11/30/can-bath-time-dangerous-pets/</a></li></ul>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}], "isInner": false}]