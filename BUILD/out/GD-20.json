[{"id": "0fa4e8a", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "ad9582a", "elType": "widget", "widgetType": "shortcode", "settings": {"shortcode": "[rank_math_breadcrumb]"}, "elements": []}, {"id": "22ebdda", "elType": "widget", "widgetType": "heading", "settings": {"title": "Contact and corrections", "header_size": "h1"}, "elements": []}, {"id": "e337a7f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Use this page to tell us about a mistake, ask a question about one of our guides, suggest a topic we haven't covered, or report a problem with the site.</p>"}, "elements": []}], "isInner": false}, {"id": "c5d63a8", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "e7931d9", "elType": "widget", "widgetType": "heading", "settings": {"title": "What you can contact us about", "header_size": "h2", "_element_id": "what-you-can-contact-us-about"}, "elements": []}, {"id": "69e7ed8", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li><strong>A correction:</strong> something in a guide looks wrong, out of date or misleading, or a source doesn't support what the page says.</li><li><strong>A question about a guide:</strong> something on a page isn't clear.</li><li><strong>A missing topic:</strong> a grooming question you couldn't find an answer to.</li><li><strong>A site problem:</strong> a broken link, something that doesn't work, or something hard to use or read, including accessibility problems.</li></ul>"}, "elements": []}, {"id": "6991381", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong>For corrections, it helps to include:</strong></p>\n<ul><li>the page;</li><li>the sentence or section you mean;</li><li>what you think is wrong;</li><li>if you have one, a source we can check.</li></ul>"}, "elements": []}, {"id": "58be949", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>How we approach corrections is explained in our <a href=\"/editorial-policy/#corrections\">editorial, sourcing and disclosure policy</a>.</p>"}, "elements": []}], "isInner": false}, {"id": "cea9b97", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "ff11f7b", "elType": "widget", "widgetType": "heading", "settings": {"title": "What we can't help with", "header_size": "h2", "_element_id": "what-we-cant-help-with"}, "elements": []}, {"id": "2ae42ed", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li><strong>Booking grooming:</strong> we aren't a grooming business. We can't book appointments, groom your dog, or recommend or list individual groomers. Our guide to <a href=\"/choosing-a-dog-groomer/\">choosing a groomer</a> explains what to look for.</li><li><strong>Veterinary advice:</strong> we can't diagnose problems or advise on treatment, medication or supplements for your dog. If you're worried about your dog's health, contact your vet.</li><li><strong>Products:</strong> we can't answer questions about orders, deliveries or returns for products sold by other businesses.</li></ul>"}, "elements": []}, {"id": "67f9259", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Please don't include health details about yourself, or personal information you don't need to share.</p>"}, "elements": []}], "isInner": false}, {"id": "f230f21", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "737735d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Send a message", "header_size": "h2", "_element_id": "send-a-message"}, "elements": []}, {"id": "73db17f", "elType": "widget", "widgetType": "shortcode", "settings": {"shortcode": "{{FORM_SHORTCODE}}"}, "elements": []}, {"id": "a6cd72f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>If you include an email address, we may reply. If you leave it out, we won't be able to.</p>"}, "elements": []}, {"id": "d716321", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>What you send through this form is handled as described in our <a href=\"/privacy-policy/\">privacy policy</a>.</p>"}, "elements": []}], "isInner": false}]