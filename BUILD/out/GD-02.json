": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/dog-coat-types/\">Dog coat types</a></strong></p><p>Not sure which row is your dog? Identify the coat first.</p>"}, "elements": []}], "isInner": true}, {"id": "a86aa73", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "569881e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/how-to-groom-your-dog-at-home/\">How to groom your dog at home</a></strong></p><p>The full routine, in the right order.</p>"}, "elements": []}], "isInner": true}, {"id": "95c4e89", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "87adedb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/brushing-your-dog/\">How to brush your dog properly</a></strong></p><p>The job your schedule depends on most.</p>"}, "elements": []}], "isInner": true}, {"id": "d2a8982", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "0a44e7b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/choosing-a-dog-groomer/\">Choosing a dog groomer</a></strong></p><p>For professional appointments.</p>"}, "elements": []}], "isInner": true}], "isInner": true}, {"id": "d777056", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>This is general information about grooming healthy dogs, not veterinary advice. If your dog has a skin, ear, eye or mouth problem, or is in pain, contact your vet. <a href=\"/editorial-policy/\">How we write, source and fund our guides</a>.</p>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}, {"id": "d2b6a49", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"sources\"><strong>Sources</strong></p>\n<ul class=\"gd-sources\"><li id=\"s1\"><span class=\"gd-src-label\">[1]</span> ASPCA: \"At-Home Pet Grooming: Top Tips and Recommendations\", 9 April 2020. <a href=\"https://www.aspca.org/news/home-pet-grooming-top-tips-and-recommendations\">https://www.aspca.org/news/home-pet-grooming-top-tips-and-recommendations</a></li><li id=\"s2\"><span class=\"gd-src-label\">[2]</span> American Kennel Club (AKC Staff): \"How to Groom Your Dog at Home: Easy Tips for Everyday Care\", updated 2 September 2026. <a href=\"https://www.akc.org/expert-advice/health/how-to-groom-a-dog/\">https://www.akc.org/expert-advice/health/how-to-groom-a-dog/</a></li><li id=\"s3\"><span class=\"gd-src-label\">[3]</span> Humane World for Animals: \"How to groom your dog at home\" (undated). <a href=\"https://www.humaneworld.org/en/resources/how-groom-your-dog-home\">https://www.humaneworld.org/en/resources/how-groom-your-dog-home</a></li><li id=\"s4\"><span class=\"gd-src-label\">[4]</span> Veterinary Oral Health Council (VOHC): home page guidance on daily oral hygiene (accessed 5 October 2026). <a href=\"https://www.vohc.org/\">https://www.vohc.org/</a></li></ul>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}], "isInner": false}]