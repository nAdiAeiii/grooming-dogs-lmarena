border"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "2bb2f25", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/brushing-your-dog/\">How to brush your dog properly</a></strong></p><p>Brushing is the step everything else depends on.</p>"}, "elements": []}], "isInner": true}, {"id": "fcdd485", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "df20224", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/dog-grooming-tools/\">Grooming tools</a></strong></p><p>Get the few tools your dog's coat actually needs.</p>"}, "elements": []}], "isInner": true}, {"id": "234e780", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "17b4551", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/choosing-a-dog-groomer/\">Choosing a dog groomer</a></strong></p><p>For the jobs that aren't home jobs.</p>"}, "elements": []}], "isInner": true}], "isInner": true}, {"id": "555c45f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>This is general information about grooming healthy dogs, not veterinary advice. If your dog is unwell, in pain or has a skin, ear, eye or mouth problem, contact your vet. <a href=\"/editorial-policy/\">How we write, source and fund our guides</a>.</p>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}, {"id": "c28210b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"sources\"><strong>Sources</strong></p>\n<ul class=\"gd-sources\"><li id=\"s1\"><span class=\"gd-src-label\">[1]</span> Ann Hohenhaus, DVM, The Animal Medical Center (New York): \"Can Bath Time be Dangerous for Pets?\", 30 November 2016. <a href=\"https://www.amcny.org/blog/2016/11/30/can-bath-time-dangerous-pets/\">https://www.amcny.org/blog/2016/11/30/can-bath-time-dangerous-pets/</a></li><li id=\"s2\"><span class=\"gd-src-label\">[2]</span> ASPCA: \"At-Home Pet Grooming: Top Tips and Recommendations\", 9 April 2020. <a href=\"https://www.aspca.org/news/home-pet-grooming-top-tips-and-recommendations\">https://www.aspca.org/news/home-pet-grooming-top-tips-and-recommendations</a></li></ul>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}], "isInner": false}]