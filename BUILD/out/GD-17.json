[{"id": "742a84f", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "2fb2478", "elType": "widget", "widgetType": "shortcode", "settings": {"shortcode": "[rank_math_breadcrumb]"}, "elements": []}, {"id": "830f280", "elType": "widget", "widgetType": "heading", "settings": {"title": "Dog grooming glossary", "header_size": "h1"}, "elements": []}, {"id": "d062179", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Met a grooming word you don't know, on this site or at the groomer? Find it below. Each term links to the guide that covers it in full.</p>", "typography_typography": "custom", "__globals__": {"typography_typography": "globals/typography?id=secondary"}}, "elements": []}, {"id": "1692bcf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>By Grooming Dogs · Updated {{UPDATED}}</p>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}, {"id": "6570e49", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#F5F7F8", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurfs", "border_color": "globals/colors?id=gdborder"}}, "elements": [{"id": "b0506a8", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong>Short answer:</strong></p>\n<ul><li><strong>Find a term below:</strong> they're grouped by theme, and each one links to the full guide.</li><li><strong>Some salon words, especially cut names like \"puppy cut\" and menu names like \"tidy\", have no standard meaning.</strong> Always confirm with your groomer what they'll actually do.</li></ul>"}, "elements": []}], "isInner": true}, {"id": "390849b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<nav aria-label=\"On this page\"><ul class=\"gd-jump\"><li><a href=\"#coat-and-hair\">Coat and hair</a></li><li><a href=\"#brushing-and-de-matting\">Brushing and de-matting</a></li><li><a href=\"#bathing-and-drying\">Bathing and drying</a></li><li><a href=\"#cuts-trims-and-blades\">Cuts, trims and blades</a></li><li><a href=\"#nails-ears-and-teeth\">Nails, ears and teeth</a></li><li><a href=\"#at-the-groomer\">At the groomer</a></li></ul></nav>"}, "elements": []}], "isInner": false}, {"id": "d79632c", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "8841a87", "elType": "widget", "widgetType": "heading", "settings": {"title": "Coat and hair", "header_size": "h2", "_element_id": "coat-and-hair"}, "elements": []}, {"id": "574096f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"coat-type\"><strong>Coat type</strong></dt><dd>The kind of coat a dog has. This site sorts coats into five groups: short and smooth, wiry, double, long and silky, and curly. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "21d37bd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"double-coat\"><strong>Double coat</strong></dt><dd>A coat with two layers: a weather-resistant outer coat of longer, coarser hairs, and a soft, dense undercoat beneath it. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "4644334", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"undercoat\"><strong>Undercoat</strong></dt><dd>The dense, soft, short layer of hair hidden beneath a longer outer coat. It's the layer that sheds most. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "9386066", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"guard-hairs\"><strong>Guard hairs (topcoat)</strong></dt><dd>The longer, stiffer outer hairs that grow through and normally hide the undercoat. Groomers also call this layer the topcoat or guard coat. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "aab23d5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"wiry-coat\"><strong>Wiry coat</strong></dt><dd>A coat of hard, crisp, rough-feeling hair, typical of many terriers. Also called wirehair. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "161515f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"feathering\"><strong>Feathering</strong></dt><dd>A longer fringe of hair on the ears, legs, tail or body. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "542c52f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"furnishings\"><strong>Furnishings</strong></dt><dd>The long hair on the head, legs and tail of certain breeds, such as a terrier's beard and eyebrows. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "0ca3d24", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"blowing-coat\"><strong>Blowing coat</strong></dt><dd>The heavy, seasonal shedding of the undercoat in many double-coated dogs. → <a href=\"/brushing-your-dog/\">Brushing your dog</a></dd></dl>"}, "elements": []}, {"id": "5eaf03e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"hand-stripping\"><strong>Hand stripping</strong></dt><dd>A specialist grooming technique for wiry coats, in which dead hairs are pulled out, by hand or with a tool, so new wiry hair can grow in. It's a skilled service, mostly used for show dogs. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "333cc46", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"carding\"><strong>Carding</strong></dt><dd>Removing dead, soft undercoat from a coat with a carding knife, a comb-like serrated blade. Groomers often combine it with a clipper trim on wiry-coated pets. → <a href=\"/dog-coat-types/\">Dog coat types</a></dd></dl>"}, "elements": []}, {"id": "afc6c94", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"shaving\"><strong>Shaving (a double coat)</strong></dt><dd>Clipping the coat down close to the skin. On a double coat this removes both layers, which grow back at different rates. → <a href=\"/dog-coat-types/#should-you-shave-a-double-coated-dog\">Should you shave a double-coated dog?</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "bfacec9", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "9fed2a0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Brushing and de-matting", "header_size": "h2", "_element_id": "brushing-and-de-matting"}, "elements": []}, {"id": "dbca9d4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"tangle\"><strong>Tangle</strong></dt><dd>A loose knot of hair, usually near the surface of the coat, that can be separated gently. → <a href=\"/brushing-your-dog/\">Brushing your dog</a></dd></dl>"}, "elements": []}, {"id": "9f801f3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"mat\"><strong>Mat (matting)</strong></dt><dd>Hair that has become packed tightly together, often close to the skin. Mats pull on the skin, and tighten further when they get wet and dry. → <a href=\"/brushing-your-dog/#dealing-with-mats\">Dealing with mats</a></dd></dl>"}, "elements": []}, {"id": "8d3f530", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"de-matting\"><strong>De-matting</strong></dt><dd>Removing mats from a coat. Tight or widespread mats are a job for a groomer, who may clip the coat short instead of brushing them out. → <a href=\"/brushing-your-dog/#dealing-with-mats\">Dealing with mats</a></dd></dl>"}, "elements": []}, {"id": "9c9169f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"line-brushing\"><strong>Line brushing</strong></dt><dd>Brushing the coat in small sections, from the skin outward, so no layer is missed. → <a href=\"/brushing-your-dog/\">Brushing your dog</a></dd></dl>"}, "elements": []}, {"id": "cd81d87", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"line-combing\"><strong>Line combing</strong></dt><dd>Working a comb through the coat section by section to lift out loose hair. Groomers use it on dense coats. → <a href=\"/brushing-your-dog/\">Brushing your dog</a></dd></dl>"}, "elements": []}, {"id": "3cc5db9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"slicker-brush\"><strong>Slicker brush</strong></dt><dd>A brush with fine wire bristles, used to work out small tangles and remove loose, dead hair. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "43c731d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"pin-brush\"><strong>Pin brush</strong></dt><dd>A brush with widely spaced pins, used on longer coats. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "0ba4692", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"bristle-brush\"><strong>Bristle brush</strong></dt><dd>A brush with soft bristles that removes loose hair and smooths the coat. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "df6e14f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"rubber-curry-brush\"><strong>Rubber curry brush</strong></dt><dd>A rubber brush that loosens dead hair, dirt and dead skin, mostly used on short, smooth coats. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "85a76ae", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"undercoat-rake\"><strong>Undercoat rake</strong></dt><dd>A rake-like tool that reaches into a thick undercoat to remove loose undercoat hair. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "9ddc132", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"de-shedding-tool\"><strong>De-shedding tool</strong></dt><dd>Any tool designed to remove loose undercoat from a double coat, such as an undercoat rake. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}, {"id": "d8794d7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"steel-comb\"><strong>Steel comb</strong></dt><dd>A metal comb used after brushing to check the coat is tangle-free right down to the skin. → <a href=\"/dog-grooming-tools/\">Choosing a brush</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "c244ea8", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "d04e3bf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Bathing and drying", "header_size": "h2", "_element_id": "bathing-and-drying"}, "elements": []}, {"id": "64b30ea", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"dog-shampoo\"><strong>Dog shampoo</strong></dt><dd>Shampoo formulated specifically for dogs, which is what dog bathing guidance recommends using. → <a href=\"/bathing-your-dog/\">Bathing your dog</a></dd></dl>"}, "elements": []}, {"id": "8e21d01", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"waterless-shampoo\"><strong>Waterless shampoo (spot cleaner)</strong></dt><dd>A pet cleaning product used on one dirty patch instead of giving a full bath. Dry shampoos and pet wipes are used the same way. → <a href=\"/bathing-your-dog/\">Bathing your dog</a></dd></dl>"}, "elements": []}, {"id": "2d41b5f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"blow-dry\"><strong>Blow-dry (blowout)</strong></dt><dd>A salon term for drying the coat with a dryer, usually while brushing it. Menus use both names, and what's included can vary. → <a href=\"/bathing-your-dog/\">Bathing your dog</a></dd></dl>"}, "elements": []}, {"id": "d3dc6b4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"high-velocity-dryer\"><strong>High-velocity dryer</strong></dt><dd>A powerful dryer whose fast airflow pushes water and loose undercoat out of the coat. It's used by groomers and at some self-service washes. → <a href=\"/bathing-your-dog/\">Bathing your dog</a></dd></dl>"}, "elements": []}, {"id": "a2f8093", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"cage-dryer\"><strong>Cage dryer</strong></dt><dd>A dryer attached to a crate, which dries a dog without anyone holding it. Heated cage dryers have been linked to serious injuries when dogs aren't watched. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "b52bb0e", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "72dfbf4", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cuts, trims and blades", "header_size": "h2", "_element_id": "cuts-trims-and-blades"}, "elements": []}, {"id": "7dcb9d0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"clippers\"><strong>Clippers</strong></dt><dd>Electric hair clippers with a cutting blade, used to cut the coat short or to an even length. → <a href=\"/dog-haircuts-and-trimming/\">Trimming and haircuts</a></dd></dl>"}, "elements": []}, {"id": "3433489", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"blade-number\"><strong>Blade number</strong></dt><dd>Clipper blades are identified by number. The number doesn't give a fixed length: the length a blade leaves changes with the blade's angle and the dog's coat, so check the manufacturer's information. → <a href=\"/dog-haircuts-and-trimming/\">Blade numbers and guide combs</a></dd></dl>"}, "elements": []}, {"id": "a97ed8d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"guide-comb\"><strong>Guide comb (guard comb)</strong></dt><dd>A plastic or metal comb that clips onto a clipper blade to set how long the hair is left. → <a href=\"/dog-haircuts-and-trimming/\">Trimming and haircuts</a></dd></dl>"}, "elements": []}, {"id": "d94917f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"blunt-ended-scissors\"><strong>Blunt-ended scissors (round-tip scissors)</strong></dt><dd>Grooming scissors with rounded tips, used for small trims near the face and paws. → <a href=\"/dog-haircuts-and-trimming/\">Trimming and haircuts</a></dd></dl>"}, "elements": []}, {"id": "4985edf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"sanitary-trim\"><strong>Sanitary trim</strong></dt><dd>Trimming the long hair around the genitals and under the tail so the area stays cleaner. Groomers may include slightly different areas. → <a href=\"/dog-haircuts-and-trimming/\">The sanitary trim</a></dd></dl>"}, "elements": []}, {"id": "d9c5aba", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"paw-pad-trim\"><strong>Paw pad trim</strong></dt><dd>Trimming the hair that grows between and over the pads of the paws. → <a href=\"/dog-haircuts-and-trimming/\">Trimming the paw pads</a></dd></dl>"}, "elements": []}, {"id": "6506e19", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"puppy-cut\"><strong>Puppy cut</strong></dt><dd>A common salon name for a haircut that's usually described as one length all over. <strong>There's no standard definition:</strong> groomers use it for very different lengths and styles, so describe the length and finish you want. → <a href=\"/dog-haircuts-and-trimming/\">Asking for the cut you want</a></dd></dl>"}, "elements": []}, {"id": "fb285cc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"teddy-bear-cut\"><strong>Teddy bear cut</strong></dt><dd>A salon name for a haircut style. <strong>It isn't standardized,</strong> and different groomers mean different things by it, so describe or show the look you want. → <a href=\"/dog-haircuts-and-trimming/\">Asking for the cut you want</a></dd></dl>"}, "elements": []}, {"id": "28c0dc0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"kennel-cut\"><strong>Kennel cut</strong></dt><dd>Another salon name for a haircut style, often a shorter one. <strong>It isn't standardized either,</strong> so agree the actual length with your groomer. → <a href=\"/dog-haircuts-and-trimming/\">Asking for the cut you want</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "54d0c5f", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "553721c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Nails, ears and teeth", "header_size": "h2", "_element_id": "nails-ears-and-teeth"}, "elements": []}, {"id": "066588d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"quick\"><strong>Quick</strong></dt><dd>The living core of a dog's nail, containing blood vessels and nerves. On light nails it shows as a pink area. → <a href=\"/trimming-dog-nails/#finding-the-quick\">Finding the quick</a></dd></dl>"}, "elements": []}, {"id": "737e593", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"dewclaw\"><strong>Dewclaw</strong></dt><dd>An extra claw higher up on the inner side of the leg, a rudimentary fifth toe. Not every dog has them. → <a href=\"/trimming-dog-nails/\">Trimming your dog's nails</a></dd></dl>"}, "elements": []}, {"id": "ce09598", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"nail-clippers\"><strong>Nail clippers</strong></dt><dd>Tools for cutting dog nails. Scissor- and plier-style clippers cut with two crossing blades; guillotine-style clippers cut with a single blade as the nail passes through a hole. → <a href=\"/dog-grooming-tools/\">Choosing clippers or a grinder</a></dd></dl>"}, "elements": []}, {"id": "53221f0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"nail-grinder\"><strong>Nail grinder</strong></dt><dd>A rotary tool that shortens nails by filing them down rather than cutting. → <a href=\"/trimming-dog-nails/\">Trimming your dog's nails</a></dd></dl>"}, "elements": []}, {"id": "cc9d6bc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"styptic-powder\"><strong>Styptic powder</strong></dt><dd>A powder pressed onto a nail tip to help stop bleeding if the quick is cut. → <a href=\"/trimming-dog-nails/\">Trimming your dog's nails</a></dd></dl>"}, "elements": []}, {"id": "8ffbf49", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"ear-flap\"><strong>Ear flap (pinna)</strong></dt><dd>The outer part of the ear that you can see and lift, supported by cartilage. Dog-show glossaries also call it the \"leather\". → <a href=\"/cleaning-dog-ears/\">Cleaning your dog's ears</a></dd></dl>"}, "elements": []}, {"id": "334d343", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"ear-canal\"><strong>Ear canal</strong></dt><dd>The passage leading down from the ear opening into the head. Nothing should be pushed into it. → <a href=\"/cleaning-dog-ears/\">Cleaning your dog's ears</a></dd></dl>"}, "elements": []}, {"id": "885fa1c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"ear-cleaner\"><strong>Ear-cleaning solution</strong></dt><dd>A liquid made for cleaning dogs' ears, ideally one recommended by your vet. → <a href=\"/cleaning-dog-ears/\">Cleaning your dog's ears</a></dd></dl>"}, "elements": []}, {"id": "2a08e2c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"ear-plucking\"><strong>Ear plucking</strong></dt><dd>Removing hair from inside the ear. Whether it's needed is debated, even among veterinary dermatologists, so ask your vet or groomer. → <a href=\"/cleaning-dog-ears/\">Cleaning your dog's ears</a></dd></dl>"}, "elements": []}, {"id": "15368d2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"plaque\"><strong>Plaque</strong></dt><dd>The buildup that forms on teeth constantly. Regular brushing is the most effective way to keep it under control. → <a href=\"/brushing-dog-teeth/\">Brushing your dog's teeth</a></dd></dl>"}, "elements": []}, {"id": "deb80c6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"tartar\"><strong>Tartar (calculus)</strong></dt><dd>The everyday name for what vets call dental calculus. Leave tartar to your vet rather than trying to remove it. → <a href=\"/brushing-dog-teeth/\">Brushing your dog's teeth</a></dd></dl>"}, "elements": []}, {"id": "6214032", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"vohc-seal\"><strong>VOHC seal</strong></dt><dd>The seal of the Veterinary Oral Health Council, a group of veterinary dentists and dental scientists. Products carrying it have submitted evidence that they help control plaque, tartar or both. → <a href=\"/brushing-dog-teeth/\">Brushing your dog's teeth</a></dd></dl>"}, "elements": []}, {"id": "6007ced", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"pet-toothpaste\"><strong>Pet toothpaste</strong></dt><dd>Toothpaste made for pets. Human toothpaste isn't a substitute, because dogs swallow it. → <a href=\"/brushing-dog-teeth/\">Brushing your dog's teeth</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "de583dd", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}}, "elements": [{"id": "7b785fc", "elType": "widget", "widgetType": "heading", "settings": {"title": "At the groomer", "header_size": "h2", "_element_id": "at-the-groomer"}, "elements": []}, {"id": "b936afc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"full-groom\"><strong>Full groom</strong></dt><dd>A salon package that usually combines a bath, drying, brushing and a haircut, often with nails and ears. <strong>What's included varies between groomers,</strong> so check before you book. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}, {"id": "a5c6d75", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"bath-and-brush\"><strong>Bath and brush</strong></dt><dd>A package with a bath, drying and brush-out but no full haircut. Some groomers include nails or ears. Names and contents vary. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}, {"id": "c239442", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"tidy\"><strong>Tidy</strong></dt><dd>A salon term for a lighter trim than a full haircut. <strong>It isn't standardized:</strong> one groomer's \"tidy\" covers feathers, belly, feet and sanitary area, while another's is a bath with nails and a trim around the eyes. Names like \"face, feet and fanny\" or \"mini groom\" are used in similar ways. Ask what's included. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}, {"id": "b96c799", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"mobile-grooming\"><strong>Mobile grooming</strong></dt><dd>Grooming done in a van or trailer parked at your home. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}, {"id": "c6d81e1", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"self-service-wash\"><strong>Self-service wash</strong></dt><dd>A business where you wash your own dog using their tubs, shampoo and dryers. → <a href=\"/choosing-a-dog-groomer/\">Choosing a groomer</a></dd></dl>"}, "elements": []}, {"id": "c421d28", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<dl class=\"gd-term\"><dt id=\"anal-glands\"><strong>Anal glands</strong></dt><dd>Two small scent glands beside a dog's anus that normally empty on their own. Some grooming menus list \"gland expression\", but veterinary guidance says emptying them is a job for a vet. → <a href=\"/dog-haircuts-and-trimming/\">Trimming and haircuts: anal glands</a></dd></dl>"}, "elements": []}], "isInner": false}, {"id": "748f4a3", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 760, "sizes": []}, "flex_direction": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}, "padding": {"unit": "px", "top": "48", "right": "24", "bottom": "48", "left": "24", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "32", "left": "16", "isLinked": false}, "background_background": "classic", "background_color": "#F5F7F8", "__globals__": {"background_color": "globals/colors?id=gdsurfs"}}, "elements": [{"id": "2591b35", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p class=\"gd-label\" id=\"next\"><strong>Where to go next</strong></p>"}, "elements": []}, {"id": "deab0c5", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_wrap": "wrap", "flex_direction_mobile": "column", "flex_gap": {"unit": "px", "size": 16, "column": "16", "row": "16", "isLinked": true}}, "elements": [{"id": "132aeb1", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "e3ff012", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/dog-coat-types/\">Dog coat types</a></strong></p><p>Which of the five coats your dog has.</p>"}, "elements": []}], "isInner": true}, {"id": "a289937", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "fb8d543", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/dog-haircuts-and-trimming/\">Trimming and haircuts at home</a></strong></p><p>Cut names, and how to describe the cut you want.</p>"}, "elements": []}], "isInner": true}, {"id": "277c726", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "9649135", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/dog-grooming-tools/\">Dog grooming tools</a></strong></p><p>Which brush or clipper suits your dog.</p>"}, "elements": []}], "isInner": true}, {"id": "ebf53ec", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"unit": "px", "size": 8, "column": "8", "row": "8", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "padding_mobile": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#D9E0E4", "__globals__": {"background_color": "globals/colors?id=gdsurf", "border_color": "globals/colors?id=gdborder"}, "width": {"unit": "%", "size": 48}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "51e3e05", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><strong><a href=\"/choosing-a-dog-groomer/\">Choosing a dog groomer</a></strong></p><p>What to ask before you book.</p>"}, "elements": []}], "isInner": true}], "isInner": true}, {"id": "b238b52", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Definitions are short summaries. The linked guides give the full picture and their sources. Coat and anatomy terms follow the American Kennel Club's glossary; salon terms reflect how US grooming businesses use them, and may differ at your groomer. <a href=\"/editorial-policy/\">How we write, source and fund our guides</a>.</p>", "text_color": "#5B6870", "__globals__": {"typography_typography": "globals/typography?id=accent", "text_color": "globals/colors?id=secondary"}}, "elements": []}], "isInner": false}]